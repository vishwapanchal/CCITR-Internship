# ═══════════════════════════════════════════════════════════════════════
# APEX-X — Single consolidated .env (backend + frontend + docker-compose)
# Place this file in the REPO ROOT. Both services load it from here:
#   • Backend  — backend/app/config.py  (python-dotenv → ../../.env)
#   • Frontend — frontend/next.config.ts (custom loadRootEnv → ../.env)
# ═══════════════════════════════════════════════════════════════════════

# ── Authentication ───────────────────────────────────────────────────
SECRET_KEY=super_secret_jwt_key_change_in_production_2026

# ── Database — SQLite (default, no extra infra needed) ───────────────
DATABASE_URL=sqlite:///./apex_x.db

# ── Database — Postgres (used by docker-compose; ignored when SQLite) ─
POSTGRES_USER=apex
POSTGRES_PASSWORD=apexpassword
POSTGRES_DB=apex_db
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432

# ── Redis (Task Queue & Caching) ────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Ollama Local LLM Inference ──────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL_CODER=qwen2.5-coder:7b
OLLAMA_MODEL_SECURITY=qwen2.5-coder:7b

# ── Neo4j Graph Database ────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=apexpassword

# ── ChromaDB Vector Store (RAG) ─────────────────────────────────────
CHROMADB_HOST=localhost
CHROMADB_PORT=8000

# ── Threat Intelligence APIs ────────────────────────────────────────
VIRUSTOTAL_API_KEY=8373fe5a36c6d0ce82742a7775b3bf1033af7a8a8458ffb6e650c590f3f6625f
IPINFO_API_TOKEN=60de8ffcfa26a3

# ── Feature Toggles ─────────────────────────────────────────────────
ALLOW_BAAS_NETWORK_ENRICHMENT=false

# ── Validation ───────────────────────────────────────────────────────
ALLOWED_EMAIL_DOMAIN=@cyber.gov

# ── Frontend (Next.js — NEXT_PUBLIC_* vars are inlined at build time) ─
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
